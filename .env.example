# PaperPilot 环境配置模板
# 用法: cp .env.example .env 然后填入自己的密钥。.env 已在 .gitignore 中,不会入库。

# ===== LLM(必填其一,推荐 DeepSeek)=====
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# ===== 各阶段模型选择(可选,默认跟随主 LLM)=====
# 对话 / 记忆 / 评测裁判 可分别指定不同模型
PAPERPILOT_CHAT_LLM=
PAPERPILOT_MEMORY_LLM=
PAPERPILOT_JUDGE_LLM=

# ===== Embedding(默认本地 hash embedding,零成本;要真实向量再配置)=====
PAPERPILOT_EMBEDDING_PROVIDER=
PAPERPILOT_EMBEDDING_MODEL=

# ===== 检索(可选,不用搜索引擎可留空,纯本地 PDF/Zotero 也能跑)=====
# BING_SEARCH_API_KEY=
# BRAVE_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_CSE_ID=

# ===== 可观测性(可选,接入 Langfuse)=====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
PAPERPILOT_OBSERVABILITY=local

# ===== 运行模式 =====
PAPERPILOT_RETRIEVAL_MODE=hybrid
PAPERPILOT_RERANKER_PROFILE=off
